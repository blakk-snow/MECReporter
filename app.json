{
  "expo": {
    "name": "MECReport",
    "slug": "MECReport",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/mec-image.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/school-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.mecreport",
      "icon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.yourcompany.mecreport",
      "permissions": [],
      "icon": "./assets/icon.png"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "e69303dc-36a7-413c-9819-ac967cc9879e"
      }
    },
    "owner": "blakksnow"
  }
}
